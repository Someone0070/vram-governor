+namespace {
+bool checkpoint_compat_enabled_for_process() {
+    static const bool enabled = []() {
+        const char * value = std::getenv("LLAMA_CHECKPOINT_COMPAT_DESCRIPTOR");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+json checkpoint_compat_canonicalize_json(const json & value) {
+    if (value.is_object()) {
+        std::vector<std::string> keys;
+        for (auto it = value.begin(); it != value.end(); ++it) keys.push_back(it.key());
+        std::sort(keys.begin(), keys.end());
+        json canonical = json::object();
+        for (const auto & key : keys) {
+            canonical[key] = checkpoint_compat_canonicalize_json(value.at(key));
+        }
+        return canonical;
+    }
+    if (value.is_array()) {
+        json canonical = json::array();
+        for (const auto & item : value) {
+            canonical.push_back(checkpoint_compat_canonicalize_json(item));
+        }
+        return canonical;
+    }
+    return value;
+}
+}
+
+bool server_context::checkpoint_compat_enabled() const {
+    return checkpoint_compat_enabled_for_process();
+}
+
+json server_context::get_checkpoint_compat_descriptor() const {
+    if (!checkpoint_compat_enabled() || impl->ctx_tgt == nullptr || impl->model_tgt == nullptr ||
+            impl->mctx != nullptr || !impl->params_base.lora_adapters.empty() ||
+            common_speculative_n_max(&impl->params_base.speculative) > 0) {
+        return nullptr;
+    }
+
+    char bytes[65536];
+    const size_t size = llama_checkpoint_compat_descriptor_json(impl->ctx_tgt, bytes, sizeof(bytes));
+    if (size == 0 || size > sizeof(bytes)) {
+        return nullptr;
+    }
+    json result = json::parse_no_throw(std::string(bytes));
+    if (result.is_discarded() || !result.is_object()) {
+        return nullptr;
+    }
+    json slots = json::array();
+    for (const auto & slot : impl->slots) {
+        if (slot.n_ctx <= 0) return nullptr;
+        slots.push_back({{"id", slot.id}, {"contextCapacity", slot.n_ctx}});
+    }
+    if (slots.empty()) return nullptr;
+    result["slots"] = std::move(slots);
+#if defined(_WIN32)
+    result["processId"] = static_cast<uint64_t>(_getpid());
+#else
+    result["processId"] = static_cast<uint64_t>(getpid());
+#endif
+    result["authority"] = "compatibility-only";
+    json canonical = checkpoint_compat_canonicalize_json(result);
+    if (!canonical.is_object() || canonical.dump().size() > sizeof(bytes) - 1) {
+        return nullptr;
+    }
+    return canonical;
+}
+
 server_response_reader server_context::get_response_reader() {
     return impl->get_response_reader();
 }
@@ -4235,5 +4313,25 @@ std::unique_ptr<server_res_generator> server_routes::handle_completions_impl(
             task_response_type res_type) {
     GGML_ASSERT(type == SERVER_TASK_TYPE_COMPLETION || type == SERVER_TASK_TYPE_INFILL);
+    if (checkpoint_compat_enabled_for_process()) {
+        std::function<bool(const json &)> has_adapter = [&](const json & value) {
+            if (value.is_object()) {
+                for (auto it = value.begin(); it != value.end(); ++it) {
+                    std::string key = it.key();
+                    std::transform(key.begin(), key.end(), key.begin(), [](unsigned char c) { return std::tolower(c); });
+                    if (key.find("adapter") != std::string::npos || key.find("lora") != std::string::npos) return true;
+                    if (has_adapter(it.value())) return true;
+                }
+            } else if (value.is_array()) {
+                for (const auto & item : value) if (has_adapter(item)) return true;
+            }
+            return false;
+        };
+        if (has_adapter(data)) {
+            auto res = create_response();
+            res->error(format_error_response("per-request adapter mutation disabled by checkpoint descriptor opt-in", ERROR_TYPE_NOT_SUPPORTED));
+            return res;
+        }
+    }
 
     auto res = create_response();
     auto completion_id = gen_chatcmplid();
@@ -4789,2 +4887,7 @@ void server_routes::init_routes() {
     this->post_props = [this](const server_http_req &) {
+        if (checkpoint_compat_enabled_for_process()) {
+            auto res = create_response();
+            res->error(format_error_response("properties mutation disabled by checkpoint descriptor opt-in", ERROR_TYPE_NOT_SUPPORTED));
+            return res;
+        }
         auto res = create_response();
@@ -5228,2 +5331,7 @@ void server_routes::init_routes() {
