 }
 
+size_t llama_checkpoint_compat_descriptor_json(const llama_context * ctx, char * buffer, size_t buffer_size) {
+    if (ctx == nullptr) {
+        return 0;
+    }
+
+    const llama_model * model = llama_get_model(ctx);
+    const llama_memory_t memory = llama_get_memory(ctx);
+    const auto * kv = dynamic_cast<const llama_kv_cache *>(memory);
+    if (model == nullptr || kv == nullptr || model->arch != LLM_ARCH_LLAMA ||
+            model->hparams.n_layer() != model->hparams.n_layer_all ||
+            ctx->get_cparams().ctx_type != LLAMA_CONTEXT_TYPE_DEFAULT ||
+            kv->get_n_swa() != 0 || !kv->get_v_trans() ||
+            ctx->get_cparams().n_rs_seq != 0 || ctx->get_cparams().embeddings ||
+            ctx->get_cparams().embeddings_nextn || kv->get_n_stream() == 0) {
+        return 0;
+    }
+
+    const auto & cp = ctx->get_cparams();
+    auto float_bits = [](float value) {
+        uint32_t bits = 0;
+        static_assert(sizeof(bits) == sizeof(value), "float bit width");
+        std::memcpy(&bits, &value, sizeof(bits));
+        std::ostringstream out;
+        out << std::hex << std::setw(8) << std::setfill('0') << bits;
+        return out.str();
+    };
+    auto tensor_json = [](const ggml_tensor * tensor) {
+        if (tensor == nullptr) {
+            return std::string("null");
+        }
+        std::ostringstream out;
+        out << "{\"type\":\"" << ggml_type_name(tensor->type)
+            << "\",\"shape\":[" << tensor->ne[0] << ',' << tensor->ne[1] << ','
+            << tensor->ne[2] << ',' << tensor->ne[3] << "],\"strides\":["
+            << tensor->nb[0] << ',' << tensor->nb[1] << ',' << tensor->nb[2] << ','
+            << tensor->nb[3] << "],\"rowBytes\":" << tensor->nb[1] << '}';
+        return out.str();
+    };
+
+    std::ostringstream out;
+    out << "{\"schemaVersion\":1,\"support\":\"plain-llama-kv\","
+        << "\"architecture\":\"llama\",\"sequenceSerializer\":\"llama-state-seq-62acc89-v1\","
+        << "\"context\":{\"nCtx\":" << cp.n_ctx << ",\"nCtxSeq\":" << cp.n_ctx_seq
+        << ",\"nBatch\":" << cp.n_batch << ",\"nUbatch\":" << cp.n_ubatch
+        << ",\"nSeqMax\":" << cp.n_seq_max << ",\"nRsSeq\":" << cp.n_rs_seq
+        << ",\"kvUnified\":" << (cp.kv_unified ? "true" : "false")
+        << ",\"causalAttention\":" << (cp.causal_attn ? "true" : "false")
+        << ",\"rope\":{\"originalContext\":" << cp.n_ctx_orig_yarn
+        << ",\"freqBaseBits\":\"" << float_bits(cp.rope_freq_base)
+        << "\",\"freqScaleBits\":\"" << float_bits(cp.rope_freq_scale)
+        << "\",\"yarnExtFactorBits\":\"" << float_bits(cp.yarn_ext_factor)
+        << "\",\"yarnAttnFactorBits\":\"" << float_bits(cp.yarn_attn_factor)
+        << "\",\"yarnBetaFastBits\":\"" << float_bits(cp.yarn_beta_fast)
+        << "\",\"yarnBetaSlowBits\":\"" << float_bits(cp.yarn_beta_slow) << "\"}},"
+        << "\"kv\":{\"subtype\":\"llama_kv_cache\",\"typeK\":\""
+        << ggml_type_name(kv->type_k()) << "\",\"typeV\":\"" << ggml_type_name(kv->type_v())
+        << "\",\"streams\":" << kv->get_n_stream() << ",\"cells\":" << kv->get_size()
+        << ",\"padding\":" << kv->get_n_pad() << ",\"vTransposed\":"
+        << (kv->get_v_trans() ? "true" : "false") << ",\"rotation\":{\"k\":"
+        << (kv->get_attn_rot_k() ? "true" : "false") << ",\"v\":"
+        << (kv->get_attn_rot_v() ? "true" : "false") << "},\"layers\":[";
+    const auto layer_ids = kv->get_layer_ids();
+    if (layer_ids.empty()) {
+        return 0;
+    }
+    for (size_t i = 0; i < layer_ids.size(); ++i) {
+        const uint32_t id = layer_ids[i];
+        const ggml_tensor * k = kv->get_k_storage(id);
+        const ggml_tensor * v = kv->get_v_storage(id);
+        if (k == nullptr || v == nullptr) {
+            return 0;
+        }
+        if (i != 0) out << ',';
+        out << "{\"layer\":" << id << ",\"k\":" << tensor_json(k)
+            << ",\"v\":" << tensor_json(v) << '}';
+    }
+    out << "]}}";
+    const std::string result = out.str();
+    const size_t required = result.size() + 1;
+    if (buffer == nullptr || buffer_size < required) {
+        return required;
+    }
+    std::memcpy(buffer, result.c_str(), required);
+    return required;
+}
+
 uint32_t llama_n_ctx_seq(const llama_context * ctx) {
     return ctx->n_ctx_seq();
 }
