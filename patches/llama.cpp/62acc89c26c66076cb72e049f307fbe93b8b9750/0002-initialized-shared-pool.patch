+bool llama_shared_pool_get_counts(
+        llama_context * ctx, uint32_t n_seq,
+        uint32_t * total_cells, uint32_t * used_cells,
+        uint32_t * unattributed_cells, uint32_t * memberships) {
+    constexpr uint32_t max_sequences = 64;
+    constexpr uint32_t max_cells = 65536;
+    if (ctx == nullptr || total_cells == nullptr || used_cells == nullptr ||
+            unattributed_cells == nullptr || memberships == nullptr || n_seq == 0 ||
+            n_seq > max_sequences || n_seq != ctx->get_cparams().n_seq_max ||
+            !ctx->get_cparams().kv_unified || ctx->get_model().arch != LLM_ARCH_LLAMA ||
+            ctx->get_model().hparams.n_layer() != ctx->get_model().hparams.n_layer_all ||
+            ctx->get_cparams().ctx_type != LLAMA_CONTEXT_TYPE_DEFAULT ||
+            ctx->get_cparams().n_rs_seq != 0 || ctx->get_cparams().embeddings ||
+            ctx->get_cparams().embeddings_nextn) return false;
+    ctx->synchronize();
+    const auto * kv = dynamic_cast<const llama_kv_cache *>(llama_get_memory(ctx));
+    if (kv == nullptr || kv->get_n_stream() != 1 || kv->get_n_swa() != 0 || !kv->get_v_trans()) return false;
+    const uint32_t total = kv->get_size();
+    if (total == 0 || total > max_cells) return false;
+    const auto & cells = kv->get_cells(0);
+    if (cells.size() != total) return false;
+    std::fill(memberships, memberships + n_seq, 0);
+    const uint32_t used = cells.get_used();
+    uint32_t scanned_used = 0;
+    uint32_t unattributed = 0;
+    for (uint32_t i = 0; i < total; ++i) {
+        if (cells.is_empty(i)) continue;
+        ++scanned_used;
+        bool attributed = false;
+        for (uint32_t seq = 0; seq < n_seq; ++seq) {
+            if (cells.seq_has(i, seq)) { ++memberships[seq]; attributed = true; }
+        }
+        if (!attributed) ++unattributed;
+    }
+    if (used != scanned_used || used > total || unattributed > used) return false;
+    *total_cells = total; *used_cells = used; *unattributed_cells = unattributed;
+    return true;
+}
+
