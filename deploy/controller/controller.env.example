# Install as /etc/vram-governor/controller.env with mode 0640, owned by
# root:vram-governor. Values are examples/placeholders and must be replaced.
VRAM_NODE_COMMAND_SECRET=__AT_LEAST_32_RANDOM_CHARACTERS__
VRAM_S3_ACCESS_KEY=__S3_ACCESS_KEY__
VRAM_S3_SECRET_KEY=__S3_SECRET_KEY__
VRAM_S3_SESSION_TOKEN=
VRAM_MANAGED_COMFY_AUTHORIZATION=Bearer __MANAGED_COMFY_TOKEN__
# Optional while the corresponding integration remains disabled.
OPENROUTER_AUTHORIZATION=
VRAM_WEBHOOK_SIGNING_SECRET=
