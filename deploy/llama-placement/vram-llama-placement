#!/usr/bin/env python3
"""Place each llama.cpp router model on one GPU or across several.

Runs before every llama-server start (ExecStartPre), so placement follows
the cards that are actually installed and the context size of the active
runtime profile. For each model it estimates the VRAM it needs (weights +
KV cache for the configured context + a working margin):

* fits the primary GPU          -> pinned there (other cards stay free)
* fits all GPUs together        -> split by layers, weighted by VRAM, with
                                   llama.cpp's auto-fit off (it misjudges
                                   cards without Resizable BAR and parked
                                   their share in system RAM)
* fits nowhere                  -> primary GPU with auto-fit (CPU spill)

Hand-written settings live in the base file and always win; the generated
presets are the base plus the placement keys.

Split ratios are calibrated, not guessed: some layer boundaries of hybrid
models run at half speed, and which ones differs per model (27B on a 4070
SUPER + 6900 XT: 9 tok/s at 11:16 but 24.5 at 12:15). --calibrate benchmarks
candidate ratios for every split model and caches the fastest per model file
and card set; without a cached result the primary GPU is filled first (it
also processes prompts fastest). Run --calibrate with llama-server stopped
after adding models or changing cards.

Models that ship multi-token-prediction layers (GGUF nextn_predict_layers)
get MTP speculative decoding (4070 SUPER: 4B 103 -> 155-167 tok/s, 27B split
19.9 -> 31-33). Its draft context needs VRAM that no estimate here or in
llama-fit-params got right (the server also sees less free memory than the
fit tool), and without that room llama.cpp moves layers to the CPU and MTP
turns 4x slower. So --calibrate loads each such model in a real llama-server
and keeps the largest pool that still loads entirely on the GPUs; a model
without a calibrated MTP pool runs without MTP. `mtp = off` in the base file
disables it for a model.

--sweep measures every chat/vision model on every placement it fits (each
GPU alone and several splits, including ones weighted to the second card):
the largest pool that loads with its projector and answers an image, the
slots that pool supports, and single-stream and all-slots throughput
(llama-batched-bench). It keeps the placement that finishes the most jobs
per second with every slot busy (prompt reading included) whose
single-stream speed is within 25% of the best; the generated presets then
use it. Run with llama-server
stopped (hours for a full model set).

usage: vram-llama-placement [--dry-run | --calibrate | --sweep [model ...]]
"""

import configparser
import io
import json
import os
import re
import struct
import subprocess
import sys
import threading
import time
import urllib.request

MODELS_DIR = os.environ.get("VG_LLAMA_MODELS_DIR", "/etc/vram-governor/llama-models")
BASE = os.environ.get("VG_LLAMA_PRESETS_BASE", "/etc/vram-governor/llama-presets.base.ini")
OUT = os.environ.get("VG_LLAMA_PRESETS", "/etc/vram-governor/llama-presets.ini")
SERVER = os.environ.get("VG_LLAMA_SERVER", "/root/llama.cpp-mixed/build/bin/llama-server")
RESERVE_MIB = int(os.environ.get("VG_LLAMA_RESERVE_MIB", "512"))
POOLS = os.environ.get("VG_LLAMA_POOLS", "/etc/vram-governor/llama-model-pools.json")
# Placement only needs room for this much context; the pool then takes all
# VRAM left on the chosen GPUs.
MIN_CONTEXT = int(os.environ.get("VG_LLAMA_MIN_CONTEXT", "8192"))
CALIBRATION = os.environ.get("VG_LLAMA_CALIBRATION", "/var/lib/vram-governor/llama-placement-calibration.json")
CACHE_BYTES = {"f32": 4.0, "f16": 2.0, "bf16": 2.0, "q8_0": 34 / 32, "q5_1": 24 / 32, "q5_0": 22 / 32, "q4_1": 20 / 32, "q4_0": 18 / 32, "iq4_nl": 18 / 32}
GIB = 1 << 30
# This tool's own keys; llama-server would reject them.
OWN_KEYS = ("placement", "mtp")


def read_gguf_metadata(path):
    """Scalar metadata of a GGUF file (arrays are skipped, except int arrays)."""
    scalar = {0: "<B", 1: "<b", 2: "<H", 3: "<h", 4: "<I", 5: "<i", 6: "<f", 7: "<?", 10: "<Q", 11: "<q", 12: "<d"}
    meta = {}
    with open(path, "rb") as f:
        if f.read(4) != b"GGUF":
            raise ValueError("not a GGUF file")
        version, = struct.unpack("<I", f.read(4))
        if version < 2:
            raise ValueError("GGUF v1 is not supported")
        _, kv_count = struct.unpack("<QQ", f.read(16))

        def string():
            n, = struct.unpack("<Q", f.read(8))
            return f.read(n).decode("utf-8", "replace")

        def value(kind):
            if kind == 8:
                return string()
            if kind == 9:
                inner, count = struct.unpack("<IQ", f.read(12))
                if inner == 8:
                    for _ in range(count):
                        n, = struct.unpack("<Q", f.read(8))
                        f.seek(n, io.SEEK_CUR)
                    return None
                fmt = scalar[inner]
                size = struct.calcsize(fmt)
                if inner in (0, 1, 2, 3, 4, 5, 7, 10, 11) and count <= 4096:
                    return [struct.unpack(fmt, f.read(size))[0] for _ in range(count)]
                f.seek(size * count, io.SEEK_CUR)
                return None
            fmt = scalar[kind]
            return struct.unpack(fmt, f.read(struct.calcsize(fmt)))[0]

        for _ in range(kv_count):
            key = string()
            kind, = struct.unpack("<I", f.read(4))
            meta[key] = value(kind)
    return meta


def kv_cache_bytes(meta, context, k_type, v_type):
    arch = meta.get("general.architecture", "")
    get = lambda name, default=None: meta.get(f"{arch}.{name}", default)
    layers = int(get("block_count", 0) or 0)
    heads = get("attention.head_count", 0) or 0
    heads = max(heads) if isinstance(heads, list) else heads
    kv_heads = get("attention.head_count_kv", heads)
    embedding = get("embedding_length", 0) or 0
    head_dim = get("attention.key_length") or (embedding // heads if heads else 0)
    value_dim = get("attention.value_length") or head_dim
    if isinstance(kv_heads, list):
        per_layer = [h for h in kv_heads[:layers] if h]
    else:
        per_layer = [kv_heads] * layers
    interval = get("full_attention_interval")
    if interval:
        # Hybrid models keep a KV cache only on their full-attention layers.
        per_layer = per_layer[::max(1, int(interval))]
    k = CACHE_BYTES.get(k_type, 2.0)
    v = CACHE_BYTES.get(v_type, 2.0)
    window = int(get("attention.sliding_window", 0) or 0)
    pattern = get("attention.sliding_window_pattern")
    if window and isinstance(pattern, list) and len(pattern) >= len(per_layer):
        # Sliding-window layers (Gemma 4: five of every six) cache only the
        # window per sequence, with their own (smaller) head sizes; reading
        # every layer as full attention put Gemma 4 31B at 13 GiB of KV for
        # 8k tokens.
        swa_key = get("attention.key_length_swa") or head_dim
        swa_value = get("attention.value_length_swa") or value_dim
        swa_tokens = min(context, window * 4 + 512)
        total = 0
        for index, heads in enumerate(per_layer):
            if pattern[index]:
                total += heads * (swa_key * k + swa_value * v) * swa_tokens
            else:
                total += heads * (head_dim * k + value_dim * v) * context
        return int(total)
    return int(sum(h * (head_dim * k + value_dim * v) for h in per_layer) * context)


def mtp_settings(meta, weights, options):
    """Speculative-decoding keys for a model with MTP layers, else {}."""
    arch = meta.get("general.architecture", "")
    if options.get("mtp") in ("0", "off", "false", "no") or not meta.get(f"{arch}.nextn_predict_layers"):
        return {}
    # Drafting 3 tokens is fastest on the small model; on the 27B split 2 is
    # as fast and steadier (prose 30.7 / code 32.6 vs 31.1 / 28.7 at 3).
    return {"spec-type": "draft-mtp", "spec-draft-n-max": "3" if weights < 6 * GIB else "2"}


def devices():
    """[(name, total_mib)] for llama.cpp's devices, one entry per physical card."""
    try:
        out = subprocess.run([SERVER, "--list-devices"], capture_output=True, text=True, timeout=60).stdout
    except Exception:
        return []
    found = []
    for line in out.splitlines():
        match = re.match(r"\s+(\w+): (.+?) \((\d+) MiB, \d+ MiB free\)", line)
        if match:
            found.append((match.group(1), match.group(2), int(match.group(3))))
    cards = []
    for name, label, total in sorted(found, key=lambda d: not d[0].startswith("CUDA")):
        card = re.sub(r"\s*\(.*\)$", "", label)
        if card not in [c[1] for c in cards]:
            cards.append((name, card, total))
    return [(name, total) for name, _, total in cards]


def models():
    """{model_id: weights_path}, as the router names them."""
    out = {}
    for entry in sorted(os.listdir(MODELS_DIR)):
        path = os.path.join(MODELS_DIR, entry)
        if entry.endswith(".gguf"):
            out[entry[:-5]] = path
        elif os.path.isdir(path):
            weights = [f for f in sorted(os.listdir(path)) if f.endswith(".gguf") and "mmproj" not in f.lower()]
            if weights:
                out[entry] = os.path.join(path, weights[0])
    return out


def mmproj_path(path):
    """The vision projector next to a model's weights, if any."""
    folder = os.path.dirname(path)
    if os.path.realpath(folder) == os.path.realpath(MODELS_DIR):
        return None
    found = sorted(f for f in os.listdir(folder) if f.endswith(".gguf") and "mmproj" in f.lower())
    return os.path.join(folder, found[0]) if found else None


def needs_measured_pool(path, placed, mtp):
    """Pools no estimate gets right: MTP drafts, split models (fit is off, so
    a wrong pool aborts the load) and vision models (projector and image
    buffers: Qwen3-VL-30B and Gemma 4 26B ran out of CUDA memory)."""
    return bool(mtp) or "," in placed.get("device", "") or mmproj_path(path) is not None


def mmproj_bytes(path):
    """Size of a vision projector next to the weights (it loads on the primary GPU)."""
    folder = os.path.dirname(path)
    if os.path.realpath(folder) == os.path.realpath(MODELS_DIR):
        return 0
    return sum(os.path.getsize(os.path.join(folder, f)) for f in os.listdir(folder) if f.endswith(".gguf") and "mmproj" in f.lower())


def placement(model, path, base, cards, context):
    options = base[model] if base.has_section(model) else {}
    if options.get("placement") == "single" and cards:
        return {"device": cards[0][0]}, "placement = single (base file) -> " + cards[0][0]
    if options.get("embeddings") in ("1", "true", "on") or not cards:
        return {"device": cards[0][0]} if cards else {}, "embedding model"
    swept = load_calibration().get(sweep_key(model, path, cards))
    if swept:
        return sweep_placed(swept), (f"swept: {swept['device']}{' ' + swept['tensor-split'] if swept.get('tensor-split') else ''}, "
                                     f"{swept['tg1']:.0f} tok/s single, {swept['tgN']:.0f} tok/s at {swept['slots']} slots")
    weights = os.path.getsize(path)
    try:
        meta = read_gguf_metadata(path)
        kv = kv_cache_bytes(meta, context, options.get("cache-type-k", "f16"), options.get("cache-type-v", "f16"))
    except Exception as error:
        return {"device": cards[0][0]}, f"metadata unreadable ({error}); primary GPU"
    # Margin calibrated on the RTX 4070 SUPER: qwen2.5-14b (8.4 GiB weights,
    # 1.7 GiB q4_0 KV at 32k) runs fully on the card using 10.0 GiB.
    need = weights + kv + GIB // 2 + weights // 50 + mmproj_bytes(path)
    capacities = [(name, (total - RESERVE_MIB) << 20) for name, total in cards]
    note = f"weights {weights / GIB:.1f} GiB + KV {kv / GIB:.1f} GiB at ctx {context} = {need / GIB:.1f} GiB"
    if need <= capacities[0][1] or len(cards) == 1:
        return {"device": cards[0][0]}, note + f" -> {cards[0][0]}"
    if need <= sum(c for _, c in capacities):
        names = ",".join(n for n, _ in capacities)
        cached = load_calibration().get(calibration_key(model, path, cards))
        if cached:
            return ({"device": names, "tensor-split": cached["tensor_split"], "n-gpu-layers": "99", "fit": "off"},
                    note + f" -> split {names} ({cached['tensor_split']}, calibrated {cached['tg']:.1f} tok/s)")
        split = split_candidates(need, capacities)[0]
        return {"device": names, "tensor-split": split, "n-gpu-layers": "99", "fit": "off"}, note + f" -> split {names} ({split}, uncalibrated)"
    # Fits nowhere: fill every GPU with as many layers as fit and leave only
    # the rest to the CPU. System RAM is 10-20x slower than VRAM, so each GB
    # kept off the CPU matters (29 GB 27B: 2.2 tok/s on one card with spill,
    # 5.6 with both cards full).
    layers = int(meta.get(f"{meta.get('general.architecture', '')}.block_count", 0) or 0)
    if layers <= 0:
        return {"device": cards[0][0]}, note + f" -> {cards[0][0]} with CPU spill (exceeds all GPUs)"
    per_layer = weights / (layers + 1)
    budget = sum(c for _, c in capacities) - kv - GIB // 2 - per_layer
    gpu_layers = max(0, min(layers, int(budget // per_layer)))
    names = ",".join(n for n, _ in capacities)
    gpu_need = int(gpu_layers * per_layer + kv + GIB // 2)
    cached = load_calibration().get(calibration_key(model, path, cards))
    split = cached["tensor_split"] if cached else split_candidates(gpu_need, capacities)[0]
    return ({"device": names, "tensor-split": split, "n-gpu-layers": str(gpu_layers), "fit": "off"},
            note + f" -> {gpu_layers}/{layers} layers on {names} ({split}{', calibrated' if cached else ''}), rest on the CPU")


def sweep_key(model, path, cards):
    return "sweep|" + calibration_key(model, path, cards)


def sweep_placed(record):
    if record.get("tensor-split"):
        return {"device": record["device"], "tensor-split": record["tensor-split"], "n-gpu-layers": "99", "fit": "off"}
    # Measured with every layer on the GPU and auto-fit off; auto-fit could
    # otherwise move layers to the CPU at the measured pool.
    return {"device": record["device"], "n-gpu-layers": "99", "fit": "off"}


FIT_CACHE = os.environ.get("VG_LLAMA_FIT_CACHE", "/var/lib/vram-governor/llama-fit-cache.json")


def fitted_context(path, device, slots, options, cards, context=None):
    """llama.cpp's own answer for one device: (n_ctx, n_gpu_layers) or None.

    llama-fit-params knows the real footprint (compute buffers, per-slot
    recurrent state) and keeps every layer on the GPU (-ngl -1) when it can;
    with the context left unset it picks the largest one that fits. Cached
    per model file, card set and settings.
    """
    binary = os.path.join(os.path.dirname(SERVER), "llama-fit-params")
    if not os.path.exists(binary):
        return None
    stat = os.stat(path)
    args = ["-m", path, "-dev", device, "-np", str(slots)]
    for key, flag in (("cache-type-k", "-ctk"), ("cache-type-v", "-ctv")):
        if options.get(key):
            args += [flag, options[key]]
    if context:
        args += ["-c", str(context)]
    key = "|".join([path, str(stat.st_size), str(int(stat.st_mtime)), ";".join(f"{n}:{t}" for n, t in cards)] + args[2:])
    try:
        with open(FIT_CACHE) as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    if key not in cache:
        try:
            out = subprocess.run([binary] + args, capture_output=True, text=True, timeout=120).stdout
            match = re.search(r"-c (\d+) -ngl (-?\d+)", out)
            cache[key] = [int(match.group(1)), int(match.group(2))] if match else None
        except Exception:
            return None
        os.makedirs(os.path.dirname(FIT_CACHE), exist_ok=True)
        tmp = FIT_CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cache, f)
        os.replace(tmp, FIT_CACHE)
    return tuple(cache[key]) if cache[key] else None


def context_pool(model, path, placed, base, cards):
    """Shared context pool for a placed model: (pool_tokens, slots, max_request).

    The pool is every byte the model's GPUs have left after its weights and
    the working margin, in tokens of this model's KV cache (llama.cpp
    unified KV: requests draw tokens from one pool instead of fixed slots).
    For a split model the pool is bounded by whichever GPU fills first, since
    each GPU holds the KV of its own layers.
    """
    options = base[model] if base.has_section(model) else {}
    meta = read_gguf_metadata(path)
    arch = meta.get("general.architecture", "")
    trained = int(meta.get(f"{arch}.context_length", 0) or 32768)
    weights = os.path.getsize(path)
    # Growth per token, measured between two sizes: sliding-window layers
    # stop growing at their window and are a fixed cost (fixed_kv), so
    # dividing the free bytes by the 1-token cost understated Gemma 4's pool.
    kv_at = lambda tokens: kv_cache_bytes(meta, tokens, options.get("cache-type-k", "f16"), options.get("cache-type-v", "f16"))
    per_token = max(1, (kv_at(65536) - kv_at(32768)) // 32768)
    fixed_kv = max(0, kv_at(32768) - per_token * 32768)
    slots = 8 if weights < 6 * GIB else 4
    names = placed.get("device", cards[0][0] if cards else "").split(",")
    capacities = {name: (total - RESERVE_MIB) << 20 for name, total in cards}
    if cards:
        capacities[cards[0][0]] -= mmproj_bytes(path)
    margin = GIB // 2 + weights // 50
    layers = int(meta.get(f"{arch}.block_count", 0) or 0)
    gpu_layers = int(placed.get("n-gpu-layers", "99"))
    if len(names) == 1:
        # One device: llama.cpp sizes the pool itself (the estimate below
        # missed per-slot state: a 4B pool sized to 210k tokens with 8 slots
        # made auto-fit move layers to the CPU, 104 -> 38 tok/s).
        fitted = fitted_context(path, names[0], slots, options, cards)
        if fitted and fitted[1] == -1:
            pool = fitted[0]
            if pool >= trained:
                bigger = fitted_context(path, names[0], slots, options, cards, context=trained * slots)
                if bigger and bigger[1] == -1:
                    pool = trained * slots
            pool -= pool % 256
            slots = max(1, min(slots, pool // 2048))
            return pool, slots, min(trained, pool), {}
        if fitted:
            # Not every layer fits even at the smallest context: use
            # llama.cpp's own layer count and context for the CPU spill.
            pool = max(2048, min(fitted[0], 16384))
            return pool, 2, min(trained, pool), {"n-gpu-layers": str(fitted[1])}
    single_spill = len(names) == 1 and weights + margin > capacities.get(names[0], 0)
    if layers and gpu_layers < layers or single_spill:
        # Partly on the CPU: keep the KV small, it competes with the layers
        # (no MTP: drafting does not pay off when layers run on the CPU).
        pool, slots = min(trained, 16384), 2
        return pool, slots, min(trained, pool), {}
    elif len(names) > 1:
        shares = [float(x) for x in placed["tensor-split"].split(",")]
        total = sum(shares)
        shares = [x / total for x in shares]
        pool_bytes = min(capacities.get(n, 0) / share - weights - margin for n, share in zip(names, shares) if share > 0) - fixed_kv
        pool = int(pool_bytes / per_token)
    else:
        pool = int((capacities.get(names[0], 0) - weights - margin - fixed_kv) / per_token)
    pool = min(pool, trained * slots)
    pool -= pool % 256
    if pool < 2048:
        pool = 2048
    slots = max(1, min(slots, pool // 2048))
    return pool, slots, min(trained, pool), {}


def mtp_key(model, path, cards, placed):
    return "mtp|" + calibration_key(model, path, cards) + "|" + placed.get("tensor-split", "")


def with_mtp(model, path, placed, base, cards, pool, slots, max_request, extra):
    """Apply the calibrated MTP pool, if this model has one."""
    options = base[model] if base.has_section(model) else {}
    mtp = mtp_settings(read_gguf_metadata(path), os.path.getsize(path), options)
    if not needs_measured_pool(path, placed, mtp) or extra or placed.get("n-gpu-layers", "99") != "99":
        return pool, slots, max_request, extra, ""
    cached = load_calibration().get(mtp_key(model, path, cards, placed))
    if not cached:
        return pool, slots, max_request, extra, "; MTP uncalibrated (run --calibrate)" if mtp else "; pool not measured (run --calibrate)"
    pool = min(pool, cached["pool"])
    slots = max(1, min(slots, pool // 2048))
    return pool, slots, min(max_request, pool), dict(extra, **mtp), "; MTP, measured pool" if mtp else "; measured pool"


def split_candidates(need, capacities):
    """tensor-split values from "fill the primary GPU" to proportional to VRAM."""
    primary, rest = capacities[0][1], capacities[1:]
    rest_total = sum(c for _, c in rest)
    shares = [min(0.97, primary / need) * k for k in (1.0, 0.9, 0.8, 0.7)]
    shares.append(primary / (primary + rest_total))
    out = []
    for share in shares:
        if need * (1 - share) > rest_total:
            continue
        parts = [round(share * 100)] + [max(1, round((1 - share) * 100 * c / rest_total)) for _, c in rest]
        value = ",".join(str(p) for p in parts)
        if value not in out:
            out.append(value)
    return out or [",".join(str(max(1, round(c / GIB))) for _, c in capacities)]


def calibration_key(model, path, cards):
    stat = os.stat(path)
    return "|".join([model, str(stat.st_size), str(int(stat.st_mtime)), ";".join(f"{n}:{t}" for n, t in cards)])


def load_calibration():
    try:
        with open(CALIBRATION) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def calibrate(base, cards, context):
    bench = os.path.join(os.path.dirname(SERVER), "llama-bench")
    results = load_calibration()
    for model, path in models().items():
        placed, note = placement(model, path, base, cards, context)
        if "tensor-split" not in placed:
            continue
        weights = os.path.getsize(path)
        capacities = [(name, (total - RESERVE_MIB) << 20) for name, total in cards]
        try:
            meta = read_gguf_metadata(path)
            options = base[model] if base.has_section(model) else {}
            need = weights + kv_cache_bytes(meta, context, options.get("cache-type-k", "f16"), options.get("cache-type-v", "f16")) + GIB // 2 + weights // 50
        except Exception:
            continue
        tried = []
        gpu_layers = placed.get("n-gpu-layers", "99")
        if gpu_layers != "99":
            layers = int(meta.get(f"{meta.get('general.architecture', '')}.block_count", 0) or 1)
            need = int(int(gpu_layers) * weights / (layers + 1) + (need - weights))
        for split in split_candidates(need, capacities):
            command = [bench, "-m", path, "-dev", placed["device"].replace(",", "/"), "-ts", split.replace(",", "/"),
                       "-ngl", gpu_layers, "-fa", "1", "-p", "128", "-n", "64", "-r", "1", "-o", "json"]
            try:
                out = subprocess.run(command, capture_output=True, text=True, timeout=900).stdout
                runs = json.loads(out[out.index("["):]) if "[" in out else []
            except Exception:
                runs = []
            tg = next((r.get("avg_ts", 0) for r in runs if r.get("n_gen", 0) > 0), 0)
            pp = next((r.get("avg_ts", 0) for r in runs if r.get("n_prompt", 0) > 0 and r.get("n_gen", 0) == 0), 0)
            tried.append({"tensor_split": split, "tg": tg, "pp": pp})
            print(f"{model}: tensor-split {split}: {tg:.1f} tok/s generation, {pp:.0f} tok/s prompt", flush=True)
        # Ratios within 5% of the fastest are equivalent for generation; of
        # those, keep the one that leaves the largest context pool (filling
        # the primary GPU first left Qwen3-VL-30B 2k tokens of context).
        fastest = max((r["tg"] for r in tried), default=0)
        for r in tried:
            try:
                r["pool"] = context_pool(model, path, dict(placed, **{"tensor-split": r["tensor_split"]}), base, cards)[0]
            except Exception:
                r["pool"] = 0
        # Prompt speed counts too: 27B Q5 at 42:58 generated at full speed but
        # read prompts at 45 tok/s instead of 402.
        quickest_prompt = max((r["pp"] for r in tried), default=0)
        best = max((r for r in tried if r["tg"] >= fastest * 0.95 and r["pp"] >= quickest_prompt * 0.7), key=lambda r: (r["pool"], r["tg"]), default=None)
        if best and best["tg"] > 0:
            results[calibration_key(model, path, cards)] = dict(best, tried=tried)
            print(f"{model}: chose {best['tensor_split']}", flush=True)
    save_calibration(results)
    # Pools measured with the real server (on the split just chosen).
    for model, path in models().items():
        options = base[model] if base.has_section(model) else {}
        if options.get("embeddings") in ("1", "true", "on"):
            continue
        mtp = mtp_settings(read_gguf_metadata(path), os.path.getsize(path), options)
        placed, _ = placement(model, path, base, cards, MIN_CONTEXT)
        if not needs_measured_pool(path, placed, mtp):
            continue
        pool, slots, _, extra = context_pool(model, path, placed, base, cards)
        if extra or placed.get("n-gpu-layers", "99") != "99":
            continue

        def fits(size):
            preset = dict(placed, **mtp)
            preset.update({"ctx-size": str(size), "parallel": str(max(1, min(slots, size // 2048))), "kv-unified": "1"})
            ok = loads_on_gpus(path, preset, options)
            print(f"{model}: MTP pool {size}: {'fits' if ok else 'does not fit'}", flush=True)
            return ok

        best = pool if fits(pool) else 0
        low, high = 8192, pool
        while not best and high - low >= 4096:
            size = (low + high) // 2 // 256 * 256
            if fits(size):
                low = size
            else:
                high = size
        best = best or (low if low > 8192 or fits(low) else 0)
        # The largest size that loads once is an edge, not a setting: the 27B
        # Q6 at its full pool passed here and then ran out of memory in the
        # router. Keep 10% headroom and require two clean runs.
        verified = 0
        for _ in range(3):
            if not best:
                break
            best = max(8192, int(best * 0.9) // 256 * 256)
            if fits(best) and fits(best):
                verified = best
                break
            if best == 8192:
                break
        best = verified
        key = mtp_key(model, path, cards, placed)
        if best:
            results[key] = {"pool": best}
            print(f"{model}: MTP pool {best} (without MTP {pool})", flush=True)
        else:
            results.pop(key, None)
        save_calibration(results)


def batched_throughput(path, preset, options, slots):
    """(single-stream gen tok/s, all-slots gen tok/s, prompt tok/s, jobs/s with
    every slot busy) via llama-batched-bench, for 1024-token prompts with
    192 generated tokens. Jobs per second counts prompt reading too: a split
    that generates more in parallel can still finish fewer jobs."""
    bench = os.path.join(os.path.dirname(SERVER), "llama-batched-bench")
    args = [bench, "-m", path, "-dev", preset["device"], "-ngl", "99", "-c", preset["ctx-size"], "--kv-unified",
            "-npp", "1024", "-ntg", "192", "-npl", "1" if slots == 1 else f"1,{slots}"]
    if preset.get("tensor-split"):
        args += ["-ts", preset["tensor-split"].replace(",", "/")]
    for key, flag in (("cache-type-k", "-ctk"), ("cache-type-v", "-ctv")):
        if options.get(key):
            args += [flag, options[key]]
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=1800).stdout
    except Exception:
        return 0.0, 0.0, 0.0, 0.0
    rows = {}
    for line in out.splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) == 10 and cells[2].isdigit():
            batch = int(cells[2])
            rows[batch] = (float(cells[5]), float(cells[7]), batch / float(cells[8]) if float(cells[8]) else 0.0)
    single = rows.get(1, (0.0, 0.0, 0.0))
    full = rows.get(slots, single)
    return single[1], full[1], single[0], full[2]


def sweep_candidates(model, path, base, cards):
    """Placements to try: each GPU alone where the model fits, then splits."""
    options = base[model] if base.has_section(model) else {}
    weights = os.path.getsize(path)
    meta = read_gguf_metadata(path)
    need = weights + kv_cache_bytes(meta, MIN_CONTEXT, options.get("cache-type-k", "f16"), options.get("cache-type-v", "f16")) + GIB // 2 + weights // 50 + mmproj_bytes(path)
    capacities = [(name, (total - RESERVE_MIB) << 20) for name, total in cards]
    if options.get("placement") == "single":
        capacities = capacities[:1]
    out = [{"device": name} for name, capacity in capacities if need <= capacity]
    if len(capacities) > 1 and need <= sum(c for _, c in capacities):
        total = sum(c for _, c in capacities)
        proportional = capacities[0][1] / total
        shares = []
        for share in (proportional + 0.1, proportional, proportional - 0.1, proportional - 0.2):
            share = round(share, 2)
            # each GPU must hold its share of the weights plus some room
            if 0.05 <= share <= 0.95 and weights * share < capacities[0][1] - GIB and weights * (1 - share) < sum(c for _, c in capacities[1:]) - GIB:
                shares.append(share)
        previous = load_calibration().get(calibration_key(model, path, cards))
        splits = [f"{round(s_ * 100)},{100 - round(s_ * 100)}" for s_ in shares]
        if previous and previous["tensor_split"] not in splits:
            splits.append(previous["tensor_split"])
        names = ",".join(n for n, _ in capacities)
        out += [{"device": names, "tensor-split": split, "n-gpu-layers": "99", "fit": "off"} for split in dict.fromkeys(splits)]
    return out


def sweep(base, cards, only):
    results = load_calibration()
    for model, path in models().items():
        if only and model not in only:
            continue
        options = base[model] if base.has_section(model) else {}
        if options.get("embeddings") in ("1", "true", "on"):
            continue
        meta = read_gguf_metadata(path)
        mtp = mtp_settings(meta, os.path.getsize(path), options)
        tried = []
        for placed in sweep_candidates(model, path, base, cards):
            label = placed["device"] + (" " + placed["tensor-split"] if placed.get("tensor-split") else "")
            estimate, slots, _, extra = context_pool(model, path, placed, base, cards)
            if extra:
                print(f"{model} [{label}]: would spill to the CPU, skipped", flush=True)
                continue

            def fits(size):
                preset = dict(placed, **mtp)
                preset.update({"ctx-size": str(size), "parallel": str(max(1, min(8, size // 8192))), "kv-unified": "1"})
                return loads_on_gpus(path, preset, options)

            low, high, best = 8192, max(8192, estimate), 0
            if fits(high):
                best = high
            else:
                while high - low >= 4096:
                    size = (low + high) // 2 // 256 * 256
                    if fits(size):
                        low = size
                    else:
                        high = size
                best = low if low > 8192 or fits(low) else 0
            pool = max(8192, int(best * 0.9) // 256 * 256) if best else 0
            if not pool or not fits(pool):
                print(f"{model} [{label}]: does not load", flush=True)
                continue
            slots = max(1, min(8, pool // 8192))
            tg1, tgn, pp, jobs = batched_throughput(path, dict(placed, **{"ctx-size": str(pool)}), options, slots)
            row = dict(placed, pool=pool, slots=slots, tg1=tg1, tgN=tgn, pp=pp, jobs=jobs)
            tried.append(row)
            print(f"{model} [{label}]: pool {pool}, {slots} slots, {tg1:.1f} tok/s single, {tgn:.1f} tok/s at {slots} slots, prompt {pp:.0f} tok/s, {jobs * 60:.1f} jobs/min", flush=True)
        if not tried:
            continue
        # Most jobs finished per second with every slot busy (prompt reading
        # included), as long as one request alone stays within 25% of the
        # fastest single-stream placement.
        best_single = max(r["tg1"] for r in tried)
        eligible = [r for r in tried if r["tg1"] >= best_single * 0.75] or tried
        winner = max(eligible, key=lambda r: (round(r["jobs"], 3), r["pool"]))
        results[sweep_key(model, path, cards)] = dict(winner, tried=tried)
        save_calibration(results)
        print(f"{model}: chose {winner['device']} {winner.get('tensor-split', '')} (pool {winner['pool']}, {winner['slots']} slots, {winner['jobs'] * 60:.1f} jobs/min)", flush=True)


def save_calibration(results):
    os.makedirs(os.path.dirname(CALIBRATION), exist_ok=True)
    tmp = CALIBRATION + ".tmp"
    with open(tmp, "w") as f:
        json.dump(results, f, indent=1)
    os.replace(tmp, CALIBRATION)


def _test_image():
    import base64
    import zlib
    width = height = 256
    rows = b"".join(b"\x00" + b"".join(bytes([(x * 7) % 256, (y * 5) % 256, 128]) for x in range(width)) for y in range(height))

    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xffffffff)

    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b"")
    return "data:image/png;base64," + base64.b64encode(png).decode()


TEST_IMAGE = _test_image()


def loads_on_gpus(path, preset, options):
    """Start llama-server with these preset keys: healthy with every layer on the GPUs?"""
    # -lv 4: the "offloaded N/M layers" line is debug-level output.
    args = [SERVER, "-m", path, "--host", "127.0.0.1", "--port", "8098", "--no-webui", "-lv", "4"]
    projector = mmproj_path(path)
    if projector:
        # The router loads the projector too; its buffers count.
        args += ["--mmproj", projector]
    merged = dict(preset)
    merged.update({k: v for k, v in options.items() if k not in OWN_KEYS})
    for key, value in merged.items():
        if key == "kv-unified":
            if value in ("1", "true", "on"):
                args.append("--" + key)
        else:
            args += ["--" + key, value]
    proc = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    log, healthy = [], False
    reader = threading.Thread(target=lambda: log.extend(proc.stderr), daemon=True)
    reader.start()
    try:
        for _ in range(300):
            if proc.poll() is not None:
                break
            try:
                healthy = urllib.request.urlopen("http://127.0.0.1:8098/health", timeout=2).status == 200
            except Exception:
                healthy = False
            if healthy:
                break
            time.sleep(1)
        if healthy:
            # MTP allocates more on its first draft: a pool that loads can
            # still run out of memory on the first request (27B Q6 at 35584).
            body = json.dumps({"prompt": "Count from one to twenty in words:", "n_predict": 48}).encode()
            endpoint = "/completion"
            if projector:
                # Encoding an image allocates the projector's compute buffers.
                body = json.dumps({"messages": [{"role": "user", "content": [{"type": "text", "text": "Describe this image."}, {"type": "image_url", "image_url": {"url": TEST_IMAGE}}]}], "max_tokens": 48}).encode()
                endpoint = "/v1/chat/completions"
            try:
                request = urllib.request.Request("http://127.0.0.1:8098" + endpoint, data=body, headers={"Content-Type": "application/json"})
                healthy = urllib.request.urlopen(request, timeout=300).status == 200 and proc.poll() is None
            except Exception:
                healthy = False
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=60)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
        reader.join(timeout=5)
    offloaded = [m.groups() for m in (re.search(r"offloaded (\d+)/(\d+) layers", line) for line in log) if m]
    return healthy and bool(offloaded) and all(a == b for a, b in offloaded)


def main():
    dry_run = "--dry-run" in sys.argv
    base = configparser.ConfigParser(interpolation=None, strict=False)
    base.optionxform = str
    if os.path.exists(BASE):
        base.read(BASE)
    context = int(os.environ.get("LLAMA_CTX_SIZE") or 32768)
    cards = devices()
    if "--calibrate" in sys.argv:
        calibrate(base, cards, context)
        return
    if "--sweep" in sys.argv:
        sweep(base, cards, [a for a in sys.argv[1:] if not a.startswith("--")])
        return
    lines = ["; Generated by vram-llama-placement before each llama-server start.",
             "; Edit %s instead; its settings always win." % BASE,
             "; GPUs: " + (", ".join(f"{n} {t} MiB" for n, t in cards) or "none found"), ""]
    sections = {s: {k: v for k, v in base[s].items() if k not in OWN_KEYS} for s in base.sections()}
    pools = {}
    for model, path in models().items():
        placed, note = placement(model, path, base, cards, MIN_CONTEXT)
        try:
            swept = load_calibration().get(sweep_key(model, path, cards))
            if swept:
                meta = read_gguf_metadata(path)
                trained = int(meta.get(f"{meta.get('general.architecture', '')}.context_length", 0) or 32768)
                mtp = mtp_settings(meta, os.path.getsize(path), base[model] if base.has_section(model) else {})
                pool, slots, max_request, extra = swept["pool"], swept["slots"], min(trained, swept["pool"]), dict(mtp)
                mtp_note = "; MTP" if mtp else ""
            else:
                pool, slots, max_request, extra = context_pool(model, path, placed, base, cards)
                pool, slots, max_request, extra, mtp_note = with_mtp(model, path, placed, base, cards, pool, slots, max_request, extra)
            placed.update({"ctx-size": str(pool), "parallel": str(slots), "kv-unified": "1"})
            placed.update(extra)
            pools[model] = {"pool_tokens": pool, "slots": slots, "max_request_tokens": max_request}
            note += f"; pool {pool} tokens, {slots} slots, up to {max_request} per request" + mtp_note
        except Exception as error:
            note += f"; no context pool ({error})"
        merged = dict(placed)
        merged.update(sections.pop(model, {}))
        lines += [f"; {note}", f"[{model}]"] + [f"{k} = {v}" for k, v in merged.items()] + [""]
    for model, options in sections.items():
        lines += [f"[{model}]"] + [f"{k} = {v}" for k, v in options.items()] + [""]
    text = "\n".join(lines)
    if dry_run:
        print(text)
        print(json.dumps(pools, indent=1))
        return
    for target, content in ((OUT, text), (POOLS, json.dumps(pools, indent=1) + "\n")):
        tmp = target + ".tmp"
        with open(tmp, "w") as f:
            f.write(content)
        os.replace(tmp, target)


if __name__ == "__main__":
    main()
