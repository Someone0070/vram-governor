#!/usr/bin/env python3
"""Calibrate every router model on every GPU placement in minutes.

The slow way measures each split ratio by trial loads. This tool measures
three placements per model (each GPU alone, one split; two splits for a model
that fits no single GPU), each a ~10 s run: load, one 1024-token job, four
parallel jobs, then the per-device buffer sizes llama.cpp logs. A per-model
fit then predicts any ratio:

  time per generated token = share * a + (1 - share) * b (+ c when split)
  time per prompt token    = share * a' + (1 - share) * b'
  pool tokens              = min over GPUs of free bytes / KV bytes per token

(InternVL3.5-8B on a 4070 SUPER + 6900 XT: generation within 1.3%, prompt
within 6%, pool within 5% of measured.) The best predicted placement is
confirmed with one more run; a ratio running >20% under prediction (layer
boundaries make some ratios collapse) is marked bad and the next best is
taken. Single-GPU runs on different cards run in parallel, and the next
models are locked into RAM while the current ones run, so loads come from
memory. Results are written where vram-llama-placement reads its placements.

Run with llama-server stopped.

usage: vram-llama-quickcal [--missing] [model ...]
  --missing  only models without a result for the current files, GPUs and
             llama.cpp build (exit 3 when nothing is missing)
"""

import configparser
import ctypes
import importlib.machinery
import importlib.util
import json
import math
import os
import re
import subprocess
import sys
import threading
import time
import urllib.request

_loader = importlib.machinery.SourceFileLoader("placement", os.environ.get("VG_LLAMA_PLACEMENT", "/usr/local/sbin/vram-llama-placement"))
_spec = importlib.util.spec_from_loader("placement", _loader)
P = importlib.util.module_from_spec(_spec)
_loader.exec_module(P)

TEST_CONTEXT = 8192
TEST_SLOTS = 4
# Server slots during tests, as in production: the Qwen3.8 4B on the 6900 XT
# (Vulkan) generated at 36 tok/s with one slot and 87 with eight.
SERVER_SLOTS = 8
SAFETY = 1 << 30            # bytes left free per GPU beyond the router reserve
PREFETCH_BYTES = 32 << 30   # model bytes kept locked in RAM ahead of the runs
GIB = 1 << 30


# --- RAM prefetch -----------------------------------------------------------

_libc = ctypes.CDLL("libc.so.6", use_errno=True)
_libc.mmap.restype = ctypes.c_void_p
_libc.mmap.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_long]
_libc.munmap.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
_libc.mlock.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
_libc.munlock.argtypes = [ctypes.c_void_p, ctypes.c_size_t]


class Prefetcher:
    """Keeps the files of upcoming models mapped and locked in RAM.

    The model cache is on ZFS, which does not keep plain reads in the page
    cache (its ARC is capped at 16 GiB here); a locked mapping does, and
    llama.cpp's own mmap of the same file then loads from memory.
    """

    def __init__(self):
        self.pins = {}
        self.busy = set()
        self.pending = {}
        self.lock = threading.Lock()

    def files(self, path):
        projector = P.mmproj_path(path)
        return [path] + ([projector] if projector else [])

    def pin(self, path):
        for name in self.files(path):
            size = os.path.getsize(name)
            with self.lock:
                if name in self.pins or name in self.busy or self.pinned_locked() + size > PREFETCH_BYTES:
                    continue
                self.busy.add(name)
            fd = os.open(name, os.O_RDONLY)
            try:
                address = _libc.mmap(None, size, 1, 1, fd, 0)  # PROT_READ, MAP_SHARED
            finally:
                os.close(fd)
            ok = address not in (None, ctypes.c_void_p(-1).value) and _libc.mlock(address, size) == 0
            if address not in (None, ctypes.c_void_p(-1).value) and not ok:
                _libc.munmap(address, size)
            with self.lock:
                self.busy.discard(name)
                if ok:
                    self.pins[name] = (address, size)

    def unpin(self, path):
        for name in self.files(path):
            with self.lock:
                pin = self.pins.pop(name, None)
            if pin:
                _libc.munlock(pin[0], pin[1])
                _libc.munmap(pin[0], pin[1])

    def pinned_locked(self):
        return sum(size for _, size in self.pins.values())

    def expect(self, path, runs):
        with self.lock:
            self.pending[path] = self.pending.get(path, 0) + runs

    def done(self, path):
        """One run of path finished; release it when no queued run needs it."""
        with self.lock:
            self.pending[path] = self.pending.get(path, 1) - 1
            last = self.pending[path] <= 0
        if last:
            self.unpin(path)

    def ahead(self, queue):
        """Pin the queued models in order while they fit the prefetch budget."""
        for path in queue:
            threading.Thread(target=self.pin, args=(path,), daemon=True).start()

    def release_all(self):
        for name in list(self.pins):
            pin = self.pins.pop(name)
            _libc.munlock(pin[0], pin[1])
            _libc.munmap(pin[0], pin[1])


# --- one measured run ---------------------------------------------------------

_BUFFER = re.compile(r"(\S+) (model|KV|RS|compute|output) buffer size = +([0-9.]+) MiB")
_CLIP = re.compile(r"CLIP using (\S+) backend")


def _post(port, path, body, timeout=600):
    request = urllib.request.Request(f"http://127.0.0.1:{port}{path}", data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
    return json.loads(urllib.request.urlopen(request, timeout=timeout).read())


def _prompt(words, seed):
    return " ".join(f"w{(seed * 7919 + i * 104729) % 50021}" for i in range(words))


def run_config(model, path, config, options, mtp, port):
    """Load model with config, run the sample jobs, return measurements or None."""
    args = [P.SERVER, "-m", path, "--host", "127.0.0.1", "--port", str(port), "--no-webui", "-lv", "4",
            "-dev", config["device"], "-ngl", "99", "-fit", "off", "-c", str(TEST_CONTEXT), "-np", str(SERVER_SLOTS), "--kv-unified"]
    if config.get("tensor-split"):
        args += ["-ts", config["tensor-split"]]
    projector = P.mmproj_path(path)
    if projector:
        args += ["--mmproj", projector]
    for key, value in mtp.items():
        args += ["--" + key, value]
    for key in ("cache-type-k", "cache-type-v"):
        if options.get(key):
            args += ["--" + key, options[key]]
    started = time.time()
    proc = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    log = []
    reader = threading.Thread(target=lambda: log.extend(proc.stderr), daemon=True)
    reader.start()
    try:
        healthy = False
        for _ in range(900):
            if proc.poll() is not None:
                break
            try:
                healthy = urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=2).status == 200
            except Exception:
                healthy = False
            if healthy:
                break
            time.sleep(0.2)
        if not healthy:
            return None
        load_seconds = time.time() - started
        # Untimed warm-up at the measured shapes: the Vulkan backend compiles
        # each kernel on first use (Gemma 4 on the 6900 XT read its first
        # prompt at 97 tok/s instead of ~1000).
        _post(port, "/completion", {"prompt": _prompt(512, 99), "n_predict": 8, "cache_prompt": False})
        warm = [threading.Thread(target=_post, args=(port, "/completion", {"prompt": _prompt(128, 90 + i), "n_predict": 4, "cache_prompt": False})) for i in range(TEST_SLOTS)]
        [t.start() for t in warm]
        [t.join() for t in warm]
        single = _post(port, "/completion", {"prompt": _prompt(768, 1), "n_predict": 96, "cache_prompt": False, "temperature": 0})["timings"]
        results = []

        def one(seed):
            results.append(_post(port, "/completion", {"prompt": _prompt(192, seed), "n_predict": 64, "cache_prompt": False, "temperature": 0})["timings"])

        t0 = time.time()
        threads = [threading.Thread(target=one, args=(seed,)) for seed in range(2, 2 + TEST_SLOTS)]
        [t.start() for t in threads]
        [t.join() for t in threads]
        parallel_seconds = time.time() - t0
        # the four requests generate together: their own generation rates add
        # up (wall time would count their prompt reading as generation)
        aggregate = sum(r.get("predicted_per_second", 0.0) for r in results)
    except Exception:
        return None
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=60)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
        reader.join(timeout=5)
    memory = {}
    clip_device = None
    for line in log:
        match = _BUFFER.search(line)
        if match:
            device, kind, mib = match.group(1), match.group(2), float(match.group(3))
            memory.setdefault(device, {}).setdefault(kind, 0.0)
            memory[device][kind] += mib
        clip = _CLIP.search(line)
        if clip:
            clip_device = clip.group(1)
    if projector and clip_device:
        memory.setdefault(clip_device, {}).setdefault("projector", 0.0)
        memory[clip_device]["projector"] += os.path.getsize(projector) / (1 << 20)
    return {"tg1": single.get("predicted_per_second", 0.0), "pp": single.get("prompt_per_second", 0.0),
            "tg_parallel": aggregate, "load_s": round(load_seconds, 1), "run_s": round(time.time() - started, 1), "memory": memory}


# --- model of one model -------------------------------------------------------

def share_of(config, primary):
    if not config.get("tensor-split"):
        return 1.0 if config["device"] == primary else 0.0
    parts = [float(x) for x in config["tensor-split"].split(",")]
    return parts[0] / sum(parts)


def cliff(measured, runs):
    """A split far below the best measured split: a layer-boundary collapse
    (Gemma 4 26B: 2180 tok/s prompt at 56:44, 134 at 52:48) that would skew
    the fit for every other ratio."""
    splits = [m for c, m in runs if m and c.get("tensor-split")]
    best_pp = max(m["pp"] for m in splits)
    best_tg = max(m["tg1"] for m in splits)
    return measured["pp"] < best_pp * 0.5 or measured["tg1"] < best_tg * 0.6


def fit(runs, primary, second):
    """Per-model coefficients from the measured runs."""
    singles = {share_of(c, primary): m for c, m in runs if m and not c.get("tensor-split")}
    splits = [(share_of(c, primary), m) for c, m in runs if m and c.get("tensor-split") and not cliff(m, runs)]

    def line(points):
        if len(points) == 1:
            return 0.0, points[0][1]
        n = len(points)
        sx = sum(x for x, _ in points); sy = sum(y for _, y in points)
        sxx = sum(x * x for x, _ in points); sxy = sum(x * y for x, y in points)
        slope = (n * sxy - sx * sy) / (n * sxx - sx * sx) if n * sxx - sx * sx else 0.0
        return slope, (sy - slope * sx) / n

    out = {}
    for key in ("tg1", "pp", "tg_parallel"):
        if 1.0 in singles and 0.0 in singles:
            a, b = 1 / singles[1.0][key], 1 / singles[0.0][key]
            c = sum(1 / m[key] - (s * a + (1 - s) * b) for s, m in splits) / len(splits) if splits else 0.0
            out[key] = {"a": a, "b": b, "c": max(0.0, c)}
        else:
            points = [(s, 1 / m[key]) for s, m in splits] + [(s, 1 / m[key]) for s, m in singles.items()]
            slope, intercept = line(points)
            out[key] = {"a": intercept + slope, "b": intercept, "c": 0.0}
    # memory: weights and KV per token split by share; other buffers fixed per GPU
    weights = kv = 0.0
    fixed = {}
    for config, measured in runs:
        if not measured:
            continue
        for device, kinds in measured["memory"].items():
            if device not in (primary, second):
                continue
            fixed[device] = max(fixed.get(device, 0.0), kinds.get("compute", 0) + kinds.get("output", 0) + kinds.get("RS", 0) + kinds.get("projector", 0))
        total_weights = sum(k.get("model", 0) for d, k in measured["memory"].items() if d in (primary, second))
        total_kv = sum(k.get("KV", 0) for d, k in measured["memory"].items() if d in (primary, second))
        weights, kv = max(weights, total_weights), max(kv, total_kv)
    out["memory"] = {"weights_mib": weights, "kv_mib_per_token": kv / TEST_CONTEXT, "fixed_mib": fixed}
    return out


def predict(model_fit, share, capacities, primary, second, split):
    t = lambda key: share * model_fit[key]["a"] + (1 - share) * model_fit[key]["b"] + (model_fit[key]["c"] if split else 0.0)
    memory = model_fit["memory"]
    pools = []
    for device, part in ((primary, share), (second, 1 - share)):
        if part <= 0:
            continue
        free = capacities[device] - part * memory["weights_mib"] - memory["fixed_mib"].get(device, 0.0) - SAFETY / (1 << 20)
        per_token = part * memory["kv_mib_per_token"]
        pools.append(free / per_token if per_token > 0 else 0)
    pool = int(min(pools)) if pools else 0
    tg1, pp, parallel = 1 / t("tg1"), 1 / t("pp"), 1 / t("tg_parallel")
    slots = max(1, min(8, pool // 8192))
    # per-stream speed falls as streams are added; interpolate from the 1- and 4-stream runs
    per_stream_at_4 = parallel / TEST_SLOTS
    per_stream = tg1 * (per_stream_at_4 / tg1) ** (math.log(slots) / math.log(TEST_SLOTS)) if slots > 1 else tg1
    seconds = slots * 1024 / pp + 192 / per_stream
    return {"share": share, "pool": pool, "slots": slots, "tg1": tg1, "pp": pp, "jobs_per_min": 60 * slots / seconds}


# --- orchestration ------------------------------------------------------------

def configs_for(path, cards, options):
    names = [n for n, _ in cards]
    capacities = {n: (t - P.RESERVE_MIB) << 20 for n, t in cards}
    weights = os.path.getsize(path) + P.mmproj_bytes(path)
    single = [{"device": n} for n in names if weights + 2 * GIB <= capacities[n]]
    if options.get("placement") == "single":
        return single[:1], []
    if len(names) < 2 or weights + 2 * GIB > sum(capacities.values()):
        return single, []
    proportional = capacities[names[0]] / sum(capacities.values())
    # A model that fits one GPU only splits for very long contexts: one
    # point suffices. One that needs both GPUs gets a scan, because collapses
    # at single layer boundaries are narrow and no formula predicts them.
    shares = [proportional] if single else [proportional + d for d in (-0.2, -0.1, 0.0, 0.1, 0.2)]
    splits = []
    for share in shares:
        share = min(0.9, max(0.1, round(share, 2)))
        if weights * share < capacities[names[0]] - GIB and weights * (1 - share) < capacities[names[1]] - GIB:
            splits.append({"device": ",".join(names[:2]), "tensor-split": f"{round(share * 100)},{100 - round(share * 100)}"})
    return single, splits


def build_id():
    """Identifies the llama.cpp build: a new build can change every speed."""
    stat = os.stat(os.path.realpath(P.SERVER))
    return f"{stat.st_size}:{int(stat.st_mtime)}"


def main():
    base = configparser.ConfigParser(interpolation=None, strict=False)
    base.optionxform = str
    base.read(P.BASE)
    cards = P.devices()
    if len(cards) < 1:
        sys.exit("no GPUs found")
    primary = cards[0][0]
    second = cards[1][0] if len(cards) > 1 else None
    capacities = {n: ((t - P.RESERVE_MIB) << 20) / (1 << 20) for n, t in cards}
    missing_only = "--missing" in sys.argv
    only = [a for a in sys.argv[1:] if not a.startswith("--")]
    build = build_id()
    existing = P.load_calibration()
    work = []
    for model, path in P.models().items():
        options = base[model] if base.has_section(model) else {}
        if only and model not in only or options.get("embeddings") in ("1", "true", "on"):
            continue
        if missing_only:
            record = existing.get(P.sweep_key(model, path, cards))
            if record and record.get("build") == build:
                continue
        mtp = P.mtp_settings(P.read_gguf_metadata(path), os.path.getsize(path), options)
        single, splits = configs_for(path, cards, options)
        work.append((model, path, options, mtp, single, splits))
    if missing_only and not work:
        print("nothing to calibrate", flush=True)
        sys.exit(3)
    started = time.time()
    prefetch = Prefetcher()
    for model, path, options, mtp, single, splits in work:
        prefetch.expect(path, len(single) + len(splits))
    runs = {model: [] for model, *_ in work}
    print_lock = threading.Lock()

    def report(model, config, measured):
        label = config["device"] + (" " + config["tensor-split"] if config.get("tensor-split") else "")
        with print_lock:
            if measured:
                print(f"| {model} | {label} | {measured['load_s']}s / {measured['run_s']}s | {measured['tg1']:.1f} | {measured['tg_parallel']:.1f} | {measured['pp']:.0f} |", flush=True)
            else:
                print(f"| {model} | {label} | — | does not load | | |", flush=True)

    # phase 1: single-GPU runs, one lane per GPU in parallel
    lanes = {}
    for model, path, options, mtp, single, splits in work:
        for config in single:
            lanes.setdefault(config["device"], []).append((model, path, options, mtp, config))
    print("| model | placement | load / whole run | gen 1 stream | gen 4 streams | prompt |\n|---|---|---|---|---|---|", flush=True)

    def lane(device, queue, port):
        for index, (model, path, options, mtp, config) in enumerate(queue):
            # the next model only: a deeper window competed with the current
            # load for disk and memory bandwidth
            prefetch.ahead([q[1] for q in queue[index:index + 2]])
            measured = run_config(model, path, config, options, mtp, port)
            runs[model].append((config, measured))
            report(model, config, measured)
            prefetch.done(path)

    threads = [threading.Thread(target=lane, args=(device, queue, 8091 + i)) for i, (device, queue) in enumerate(lanes.items())]
    [t.start() for t in threads]
    [t.join() for t in threads]
    # phase 2: split runs (both GPUs), one at a time
    split_queue = [(model, path, options, mtp, config) for model, path, options, mtp, _, splits in work for config in splits]
    for index, (model, path, options, mtp, config) in enumerate(split_queue):
        prefetch.ahead([q[1] for q in split_queue[index:index + 2]])
        measured = run_config(model, path, config, options, mtp, 8095)
        runs[model].append((config, measured))
        report(model, config, measured)
        prefetch.done(path)
    # fit, choose, confirm
    results = P.load_calibration()
    print("\n| model | chosen | pool | slots | gen 1 stream | prompt | jobs/min (predicted) | confirmed |\n|---|---|---|---|---|---|---|---|", flush=True)
    for model, path, options, mtp, single, splits in work:
        measured_runs = [(c, m) for c, m in runs[model] if m]
        if not measured_runs:
            continue
        model_fit = fit(measured_runs, primary, second)
        candidates = []
        for config, _ in measured_runs:
            if not config.get("tensor-split"):
                candidates.append((config, predict(model_fit, share_of(config, primary), capacities, primary, second, False)))
        measured_splits = [(c, m) for c, m in measured_runs if c.get("tensor-split")]
        cliffs = [share_of(c, primary) for c, m in measured_splits if cliff(m, measured_runs)]
        for config, measured in measured_splits:
            if not cliff(measured, measured_runs):
                # a measured ratio is a candidate as is, with its measured speeds
                predicted = predict(model_fit, share_of(config, primary), capacities, primary, second, True)
                predicted.update(tg1=measured["tg1"], pp=measured["pp"])
                candidates.append((dict(config, **{"n-gpu-layers": "99", "fit": "off"}), predicted))
        if measured_splits and second:
            for step in range(5, 100, 5):
                share = step / 100
                weights = model_fit["memory"]["weights_mib"]
                if weights * share > capacities[primary] - 1024 or weights * (1 - share) > capacities[second] - 1024:
                    continue
                if any(abs(share - bad) <= 0.03 for bad in cliffs):
                    continue
                config = {"device": f"{primary},{second}", "tensor-split": f"{step},{100 - step}", "n-gpu-layers": "99", "fit": "off"}
                candidates.append((config, predict(model_fit, share, capacities, primary, second, True)))
        candidates = [(c, p) for c, p in candidates if p["pool"] >= 4096]
        if not candidates:
            continue
        best_single = max(p["tg1"] for _, p in candidates)
        ranked = sorted((cp for cp in candidates if cp[1]["tg1"] >= best_single * 0.75), key=lambda cp: (cp[1]["jobs_per_min"], cp[1]["pool"]), reverse=True)
        chosen = None
        for config, predicted in ranked[:4]:
            measured = next((m for c, m in measured_runs if c["device"] == config["device"] and c.get("tensor-split") == config.get("tensor-split")), None)
            if measured is None:
                measured = run_config(model, path, config, options, mtp, 8096)
            ok = measured is not None and measured["tg1"] >= predicted["tg1"] * 0.8 and measured["pp"] >= predicted["pp"] * 0.6
            pool = max(4096, int(predicted["pool"] * 0.9) // 256 * 256)
            if ok:
                # The pool is calculated from logged buffers; confirm it by
                # loading at that size with the projector and an image request.
                preset = dict(config, **mtp)
                for _ in range(4):
                    preset.update({"ctx-size": str(pool), "parallel": str(max(1, min(8, pool // 8192))), "kv-unified": "1", "n-gpu-layers": "99", "fit": "off"})
                    if P.loads_on_gpus(path, preset, options):
                        break
                    pool = max(4096, int(pool * 0.85) // 256 * 256)
                else:
                    ok = False
            if ok:
                record = dict(config, build=build, pool=pool, slots=max(1, min(8, pool // 8192)), tg1=measured["tg1"], pp=measured["pp"],
                              tgN=measured["tg_parallel"], jobs=predicted["jobs_per_min"] / 60, predicted=predicted, fit=model_fit)
                if not record.get("tensor-split"):
                    record.pop("n-gpu-layers", None)
                    record.pop("fit", None)
                chosen = record
                label = config["device"] + (" " + config["tensor-split"] if config.get("tensor-split") else "")
                print(f"| {model} | {label} | {pool} | {record['slots']} | {measured['tg1']:.1f} | {measured['pp']:.0f} | {predicted['jobs_per_min']:.1f} | ✅ |", flush=True)
                break
            label = config["device"] + (" " + config["tensor-split"] if config.get("tensor-split") else "")
            print(f"| {model} | {label} | | | {measured['tg1'] if measured else 0:.1f} | {measured['pp'] if measured else 0:.0f} | {predicted['jobs_per_min']:.1f} | ❌ bad ratio |", flush=True)
        if chosen:
            results[P.sweep_key(model, path, cards)] = chosen
            P.save_calibration(results)
    prefetch.release_all()
    print(f"\ncalibrated {len(work)} models in {time.time() - started:.0f}s", flush=True)


if __name__ == "__main__":
    main()
