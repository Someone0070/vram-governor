[Unit]
Description=llama.cpp router: second GPU (RX 6900 XT) only
After=network.target mnt-models.mount
RequiresMountsFor=/mnt/models

[Service]
Type=simple
WorkingDirectory=/root/llama.cpp-mixed
Environment=LD_LIBRARY_PATH=/root/llama.cpp-mixed/build/bin
Environment=VG_LLAMA_ROLE=gpu1
Environment=VG_LLAMA_ROLE_MODELS_DIR=/etc/vram-governor/llama-models-gpu1
Environment=VG_LLAMA_PRESETS=/etc/vram-governor/llama-presets-gpu1.ini
Environment=VG_LLAMA_POOLS=/etc/vram-governor/llama-model-pools-gpu1.json
ExecStartPre=/usr/local/sbin/vram-llama-placement
ExecStart=/usr/bin/env CUDA_VISIBLE_DEVICES= /root/llama.cpp-mixed/build/bin/llama-server --host 127.0.0.1 --port 8085 --no-webui --models-dir /etc/vram-governor/llama-models-gpu1 --models-preset /etc/vram-governor/llama-presets-gpu1.ini --models-max 1 --no-models-autoload --metrics
Restart=on-failure

[Install]
WantedBy=multi-user.target
