{
  "id": "video-minimax-h3-flf",
  "version": 1,
  "title": "Start + end frame video (MiniMax-H3 + audio)",
  "description": "Generates the motion between a first and a last frame. Describe what happens in between. 768x448.",
  "operation": "video.first_last_frame",
  "profile": "video-minimax-h3-i2v@1",
  "outputs": [
    "video/mp4"
  ],
  "typical_seconds": 180,
  "params": [
    {
      "name": "image",
      "type": "image",
      "required": true,
      "description": "Start frame (artifact id).",
      "bind": [
        {
          "node": "114",
          "input": "image"
        }
      ]
    },
    {
      "name": "last_image",
      "type": "image",
      "required": true,
      "description": "End frame (artifact id).",
      "bind": [
        {
          "node": "900",
          "input": "image"
        }
      ]
    },
    {
      "name": "prompt",
      "type": "string",
      "required": true,
      "max_length": 4000,
      "description": "Describe the motion, camera and sound; for cartoons say the subject keeps the same size and shape.",
      "bind": [
        {
          "node": "s104",
          "input": "prompt"
        }
      ]
    },
    {
      "name": "seconds",
      "type": "number",
      "default": 4.0,
      "min": 1.0,
      "max": 10.0,
      "description": "Clip length (24 fps).",
      "bind": [
        {
          "node": "s111",
          "input": "value"
        }
      ]
    },
    {
      "name": "seed",
      "type": "seed",
      "description": "Same seed and params give the same result. Random when omitted.",
      "bind": [
        {
          "node": "s15",
          "input": "noise_seed"
        }
      ]
    },
    {
      "name": "turbo",
      "type": "boolean",
      "default": true,
      "description": "8-step turbo LoRA (about 3 min). false runs 20 steps: slower, sometimes cleaner.",
      "bind": [
        {
          "node": "s126",
          "input": "value"
        }
      ]
    }
  ],
  "graph": {
    "92": {
      "class_type": "SaveVideo",
      "inputs": {
        "filename_prefix": "lb/minimax-h3-flf",
        "video": [
          "s91",
          0
        ],
        "format": "mp4",
        "codec": "h264"
      }
    },
    "114": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "s11": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_video_vae_fp16.safetensors"
      }
    },
    "s24": {
      "class_type": "VAELoader",
