{
  "id": "image-sdxl",
  "version": 1,
  "title": "Image (SDXL base)",
  "description": "Classic SDXL 1.0. Lighter on VRAM and well understood; lower quality than Qwen or Krea.",
  "operation": "image.generate",
  "profile": "image-sdxl-base@1",
  "outputs": [
    "image/png"
  ],
  "typical_seconds": 25,
  "params": [
    {
      "name": "prompt",
      "type": "string",
      "required": true,
      "max_length": 4000,
      "description": "What to generate.",
      "bind": [
        {
          "node": "2",
          "input": "text"
        }
      ]
    },
    {
      "name": "negative_prompt",
      "type": "string",
      "default": "blurry, low quality, text, watermark, oversaturated",
      "max_length": 2000,
      "description": "What to avoid.",
      "bind": [
        {
          "node": "3",
          "input": "text"
        }
      ]
    },
    {
      "name": "width",
      "type": "integer",
      "default": 1024,
      "min": 512,
      "max": 1536,
      "multiple_of": 16,
      "description": "Image width in pixels.",
      "bind": [
        {
          "node": "4",
          "input": "width"
        }
      ]
    },
    {
      "name": "height",
      "type": "integer",
      "default": 1024,
      "min": 512,
      "max": 1536,
      "multiple_of": 16,
      "description": "Image height in pixels.",
      "bind": [
        {
          "node": "4",
          "input": "height"
        }
      ]
    },
    {
      "name": "seed",
      "type": "seed",
      "description": "Same seed and params give the same result. Random when omitted.",
      "bind": [
        {
          "node": "5",
          "input": "seed"
        }
      ]
    },
    {
      "name": "steps",
      "type": "integer",
      "default": 28,
      "min": 10,
      "max": 60,
      "description": "More steps give more detail, slower.",
      "bind": [
        {
          "node": "5",
          "input": "steps"
        }
      ]
    },
    {
      "name": "cfg",
      "type": "number",
      "default": 6.0,
      "min": 1.0,
      "max": 12.0,
      "description": "Prompt adherence.",
      "bind": [
        {
          "node": "5",
          "input": "cfg"
        }
      ]
    }
  ],
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_base_1.0.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "1",
          1
        ]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, text, watermark, oversaturated",
        "clip": [
          "1",
          1
        ]
      }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 123456789,
        "steps": 28,
        "cfg": 6.0,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1.0,
        "model": [
          "1",
          0
        ],
        "positive": [
          "2",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "4",
          0
        ]
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "5",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "lb/sdxl",
        "images": [
          "6",
          0
        ]
      }
    }
  }
}
