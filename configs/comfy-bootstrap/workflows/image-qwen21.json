{
  "id": "image-qwen21",
  "version": 1,
  "title": "Image (Qwen-Image 2.1)",
  "description": "General-purpose images with strong prompt following and legible text inside the image (signs, posters, labels). For stylized or cartoon looks image-krea2-turbo is faster and usually nicer.",
  "operation": "image.generate",
  "profile": "image-qwen21@1",
  "outputs": [
    "image/png"
  ],
  "typical_seconds": 50,
  "params": [
    {
      "name": "prompt",
      "type": "string",
      "required": true,
      "max_length": 4000,
      "description": "What to generate.",
      "bind": [
        {
          "node": "4",
          "input": "prompt"
        }
      ]
    },
    {
      "name": "negative_prompt",
      "type": "string",
      "default": "",
      "max_length": 2000,
      "description": "What to avoid.",
      "bind": [
        {
          "node": "4",
          "input": "negative_prompt"
        }
      ]
    },
    {
      "name": "width",
      "type": "integer",
      "default": 1024,
      "min": 512,
      "max": 1536,
      "multiple_of": 16,
      "description": "Image width in pixels.",
      "bind": [
        {
          "node": "6",
          "input": "width"
        }
      ]
    },
    {
      "name": "height",
      "type": "integer",
      "default": 1024,
      "min": 512,
      "max": 1536,
      "multiple_of": 16,
      "description": "Image height in pixels.",
      "bind": [
        {
          "node": "6",
          "input": "height"
        }
      ]
    },
    {
      "name": "seed",
      "type": "seed",
      "description": "Same seed and params give the same result. Random when omitted.",
      "bind": [
        {
          "node": "7",
          "input": "seed"
        }
      ]
    },
    {
      "name": "steps",
      "type": "integer",
      "default": 25,
      "min": 8,
      "max": 50,
      "description": "More steps give more detail, slower.",
      "bind": [
        {
          "node": "7",
          "input": "steps"
        }
      ]
    },
    {
      "name": "cfg",
      "type": "number",
      "default": 1.0,
      "min": 1.0,
      "max": 6.0,
      "description": "At 1.0 the negative prompt is ignored; raise to 2.5-4 to use it (about 2x slower).",
      "bind": [
        {
          "node": "7",
          "input": "cfg"
        }
      ]
    }
  ],
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
        "weight_dtype": "default"
      },
      "_meta": {
        "title": "Qwen-Image 2.1 (int8)"
      }
    },
    "2": {
      "class_type": "QwenImage21Cache",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "device": "auto",
        "dtype": "default"
      },
      "_meta": {
        "title": "Qwen 2.1 cache"
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
        "type": "qwen_image",
        "device": "default"
      },
      "_meta": {
        "title": "Text encoder (Qwen3-VL 8B int8)"
      }
    },
    "4": {
      "class_type": "TextEncodeQwenImage21",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "prompt": "",
        "negative_prompt": "",
        "resolution": 1024
      },
      "_meta": {
        "title": "Prompt"
      }
    },
    "5": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "texture_fix_vae_for_qwen_image_2.1_bf16.safetensors"
      },
      "_meta": {
        "title": "Texture-fix VAE"
      }
    },
    "6": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      },
      "_meta": {
        "title": "Size"
      }
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "positive": [
          "4",
          0
        ],
        "negative": [
          "4",
          1
        ],
        "latent_image": [
          "6",
          0
        ],
        "seed": 101,
        "steps": 25,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      },
      "_meta": {
        "title": "Sampler (template: 25 steps, CFG 1)"
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "7",
          0
        ],
        "vae": [
          "5",
          0
        ]
      },
      "_meta": {
        "title": "Decode"
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "8",
          0
        ],
        "filename_prefix": "lb/qwen21"
      },
      "_meta": {
        "title": "Qwen-Image 2.1 result"
      }
    }
  }
}
