{
  "id": "video-ltx25-t2v",
  "version": 1,
  "title": "Text-to-video (LTX-2.5, two-stage + audio)",
  "description": "LTX-2.5 two-stage render (half-res pass, 2x latent upscale, refine) with generated audio. Great for 3D and stylized shots; weak on flat 2D cartoons.",
  "operation": "video.generate_sequence",
  "profile": "video-ltx25-t2v@1",
  "outputs": [
    "video/mp4"
  ],
  "typical_seconds": 150,
  "params": [
    {
      "name": "prompt",
      "type": "string",
      "required": true,
      "max_length": 4000,
      "description": "Describe the shot: subject, action, camera and sound. Generated audio follows the prompt.",
      "bind": [
        {
          "node": "s376",
          "input": "value"
        }
      ]
    },
    {
      "name": "negative_prompt",
      "type": "string",
      "default": "pc game, console game, video game, cartoon, childish, ugly",
      "max_length": 2000,
      "description": "What to avoid.",
      "bind": [
        {
          "node": "s373",
          "input": "text"
        }
      ]
    },
    {
      "name": "seconds",
      "type": "integer",
      "default": 5,
      "min": 1,
      "max": 10,
      "description": "Clip length (24 fps).",
      "bind": [
        {
          "node": "s362",
          "input": "value"
        }
      ]
    },
    {
      "name": "aspect_ratio",
      "type": "enum",
      "default": "16:9 (Widescreen)",
      "values": [
        "1:1 (Square)",
        "2:3 (Portrait Photo)",
        "3:2 (Photo)",
        "3:4 (Portrait Standard)",
        "4:3 (Standard)",
        "9:16 (Portrait Widescreen)",
        "16:9 (Widescreen)",
        "21:9 (Ultrawide)"
      ],
      "description": "Frame shape.",
      "bind": [
        {
          "node": "409",
          "input": "aspect_ratio"
        }
      ]
    },
    {
      "name": "megapixels",
      "type": "number",
      "default": 0.9,
      "min": 0.1,
      "max": 0.9,
      "description": "Output size: 0.25 is about 672x384 at 16:9, 0.9 about 1280x704.",
      "bind": [
        {
          "node": "409",
          "input": "megapixels"
        }
      ]
    },
    {
      "name": "seed",
      "type": "seed",
      "description": "Same seed and params give the same result. Random when omitted.",
      "bind": [
        {
          "node": "s338",
          "input": "noise_seed"
        },
        {
          "node": "s339",
          "input": "noise_seed"
        }
      ]
    },
    {
      "name": "enhance_prompt",
      "type": "boolean",
      "default": false,
      "description": "Let the built-in Gemma model rewrite the prompt into a detailed shot description (slower).",
      "bind": [
        {
          "node": "s383",
          "input": "value"
        }
      ]
    }
  ],
